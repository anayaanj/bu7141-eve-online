// BU7141 — EVE Online subscription KPIs: ERD v1 (clean / transformed model)
// Paste into https://dbdiagram.io to view. Source of truth lives in the repo; change it via pull request.
// Every table notes which raw source it is built from (see docs/raw_inventory.md, section numbers in brackets).
// Derived attributes are marked '/derived:' (the textbook's '/' prefix) and derived tables have a grey header.
// docs/erd_design.md explains the normalization (1NF-3NF) and why each derived column is stored.

Project bu7141_eve_online {
  database_type: 'PostgreSQL'
  Note: '''
  v1 draft. Per-player tables (Customer, Engagement, Retention) are real per-character data.
  Monetization is company level only: no public per-player Subscription or Payment records exist.
  Per-player and company-level data meet only on calendar_date.
  '''
}

// ───────────────────────── Shared dimensions ─────────────────────────

Table calendar_date {
  date date [pk]
  month date [not null, note: '/derived: first day of the month of date. Used for cohorts and MAU']
  quarter varchar [not null, note: '/derived: year and quarter of date, e.g. 2025Q3. Joins Pearl Abyss quarters']
  year int [not null, note: '/derived: year of date']
  after_sale boolean [not null, note: '/derived: date >= 2026-05-06, when Pearl Abyss completed the sale of CCP (2Q26 letter)']
  Note: 'Generated. The glue between per-player and company-level data.'
}

Table region {
  region_id int [pk]
  region_name varchar [not null]
  Note: 'SDE mapRegions [9].'
}

Table constellation {
  constellation_id int [pk]
  constellation_name varchar [not null]
  region_id int [not null, ref: > region.region_id]
  Note: 'SDE mapConstellations [9]. Needed for sovereignty campaigns.'
}

Table solar_system {
  solar_system_id int [pk]
  solar_system_name varchar [not null]
  constellation_id int [not null, ref: > constellation.constellation_id]
  security_status decimal
  security_band varchar [note: 'High Sec / Low Sec / Null Sec / Wormhole']
  map_x "double precision" [note: 'CCP 2D map position (SDE position2D.x); null for wormholes and other off-map systems']
  map_y "double precision" [note: 'CCP 2D map position (SDE position2D.y)']
  is_starter_system boolean [note: 'A school starting system for new characters (SDE schoolMap)']
  Note: 'SDE mapSolarSystems [9], security band from MER static_solarsystems [4].'
}

Table stargate_link {
  from_solar_system_id int [ref: > solar_system.solar_system_id]
  to_solar_system_id int [ref: > solar_system.solar_system_id]
  indexes {
    (from_solar_system_id, to_solar_system_id) [pk]
  }
  Note: 'SDE mapStargates [9]: one row per stargate connection between two systems (each direction stored once). Draws the map.'
}

Table item_category {
  category_id int [pk]
  category_name varchar [not null, note: 'e.g. Ship, Module, Charge']
  Note: 'SDE categories [9].'
}

Table item_group {
  group_id int [pk]
  group_name varchar [not null, note: 'e.g. Frigate, Assault Frigate, Battleship']
  category_id int [not null, ref: > item_category.category_id]
  Note: 'SDE groups [9]. Ship class for feature adoption.'
}

Table item_type {
  type_id int [pk]
  type_name varchar [not null]
  group_id int [not null, ref: > item_group.group_id]
  mean_isk_value decimal [note: 'MER static_type_values [4]']
  alpha_can_fly boolean [note: '/derived: ships only. Every skill the ship requires (SDE typeDogma) is within the Alpha clone limits (SDE cloneGrades)']
  Note: 'SDE types [9].'
}

// ───────────────────────── Customer & Acquisition ─────────────────────────

Table alliance {
  alliance_id int [pk]
  alliance_name varchar
  ticker varchar
  date_founded timestamp
  executor_corporation_id int
  Note: 'Character dump alliances.json [2].'
}

Table corporation {
  corporation_id int [pk]
  corporation_name varchar
  ticker varchar
  alliance_id int [ref: >? alliance.alliance_id]
  date_founded timestamp
  member_count int
  is_npc boolean [note: '/derived: corporation_id < 2000000 (CCP-run starter corps, incl. Doomheim)']
  Note: 'Character dump corporations.json [2].'
}

Table player_character {
  character_id bigint [pk, note: 'Customer. One account can own several characters.']
  character_name varchar
  signup_date date [note: 'birthday: dump if real (>= 2003), else ESI, else null']
  signup_date_source varchar [note: 'dump / esi / unknown']
  cohort_month date [note: '/derived: signup month. Exact from character_signup_month ID ranges for characters created from 2024; first day of the month of signup_date for older ones']
  gender varchar
  race_id int
  bloodline_id int
  corporation_id int [not null, ref: > corporation.corporation_id, note: 'current, at snapshot']
  security_status decimal
  is_deleted boolean [note: '/derived: dump deleted flag OR ESI 404 OR corporation_id = 1000001 (Doomheim)']
  inferred_plan varchar [note: '/derived: omega if any killmail_participant row flies an item_type with alpha_can_fly = false, else unknown. Never alpha: absence proves nothing']
  first_omega_seen date [note: '/derived: earliest kill_date in a ship with alpha_can_fly = false']
  Note: 'Customer. Character dump [2] + ESI [2b]. Scope: characters active in killmails or contracts, Jan 2024 - Aug 2026 (889,560). Signup totals for everyone are in character_signup_month.'
}

Table character_signup_month {
  month date [pk]
  first_character_id bigint [not null, note: 'first character created that month']
  characters_created int [not null, note: '/derived: first_character_id of the next month minus first_character_id of this month']
  Note: 'Exact signups for every character, seen or not, deleted or not [11]. Characters, not accounts.'
}

// ───────────────────────── Engagement & Retention ─────────────────────────

Table killmail {
  killmail_id bigint [pk]
  killmail_time timestamp [not null]
  kill_date date [not null, ref: > calendar_date.date, note: '/derived: date part of killmail_time']
  solar_system_id int [not null, ref: > solar_system.solar_system_id]
  war_id int [ref: >? war.war_id]
  battle_id int [ref: >? battle.battle_id, note: '/derived: battle the killmail falls in (system + hour cluster)']
  attacker_count int [note: '/derived: count of attacker rows in killmail_participant']
  Note: 'UsageEvent. One ship destroyed [1].'
}

Table killmail_participant {
  killmail_id bigint [ref: > killmail.killmail_id]
  participant_no int [note: '0 = victim, 1..n = attackers']
  role varchar [not null, note: 'victim / attacker']
  character_id bigint [ref: >? player_character.character_id, note: 'null for NPCs and structures']
  corporation_id int [ref: >? corporation.corporation_id, note: 'at the time of the kill']
  alliance_id int [ref: >? alliance.alliance_id, note: 'at the time of the kill']
  ship_type_id int [ref: >? item_type.type_id]
  weapon_type_id int [ref: >? item_type.type_id]
  damage int [note: 'damage_taken for victim, damage_done for attacker']
  final_blow boolean
  indexes {
    (killmail_id, participant_no) [pk]
    (character_id, killmail_id)
  }
  Note: 'Victim and attackers in one table, so "was this character active?" is one lookup [1].'
}

Table contract {
  contract_id bigint [pk]
  issuer_character_id bigint [not null, ref: > player_character.character_id]
  issuer_corporation_id int [ref: >? corporation.corporation_id]
  contract_type varchar [not null, note: 'item_exchange / auction / courier']
  date_issued timestamp [not null]
  issued_date date [not null, ref: > calendar_date.date, note: '/derived: date part of date_issued']
  date_expired timestamp
  price decimal
  reward decimal
  collateral decimal
  volume decimal
  region_id int [ref: >? region.region_id]
  solar_system_id int [ref: >? solar_system.solar_system_id]
  first_seen date [note: '/derived: earliest daily snapshot containing the contract']
  last_seen date [note: '/derived: latest daily snapshot containing the contract']
  Note: 'Non-combat activity (traders, haulers). Daily snapshots deduplicated on contract_id [10].'
}

Table contract_item {
  contract_id bigint [ref: > contract.contract_id]
  record_id bigint
  type_id int [not null, ref: > item_type.type_id]
  quantity bigint [not null]
  is_included boolean [not null, note: 'true: the issuer offers the item; false: the issuer asks for it']
  indexes {
    (contract_id, record_id) [pk]
  }
  Note: 'Items bought with real money from CCP (PLEX, Skill Extractor, Large/Small Skill Injector, Multiple Pilot Training Certificate, Daily Alpha Injector) in contracts [10]. The per-player link to real-money spending: someone paid for these.'
}

Table character_month_activity [headercolor: #9E9E9E] {
  character_id bigint [ref: > player_character.character_id]
  month date
  kills int [note: '/derived: count of attacker rows that month']
  losses int [note: '/derived: count of victim rows that month']
  contracts_issued int [note: '/derived: count of contracts issued that month']
  active_days int [note: '/derived: distinct days with a killmail or contract']
  flew_omega_ship boolean [note: '/derived: any row that month in a ship with alpha_can_fly = false']
  plex_offered bigint [note: '/derived: PLEX quantity in contract_item rows with is_included = true, in contracts the character issued that month']
  in_player_corporation boolean [note: '/derived: corporation at last activity that month has is_npc = false']
  indexes {
    (character_id, month) [pk]
  }
  Note: '/derived table. From killmail_participant and contract. Feeds DAU/MAU, cohort retention, churn, social glue.'
}

Table players_online_daily [headercolor: #9E9E9E] {
  date date [pk, ref: - calendar_date.date]
  avg_players int [note: '/derived: mean of the 30-minute points that day']
  peak_players int [note: '/derived: max of the 30-minute points that day']
  min_players int [note: '/derived: min of the 30-minute points that day']
  outage_minutes int [note: '/derived: 30-minute points with no data or 0 players outside daily downtime, x 30. Service-quality proxy']
  Note: '/derived table. Concurrent players, all activities, from 30-minute points [12].'
}

// ───────────────────────── Conflict & events ─────────────────────────

Table war {
  war_id int [pk]
  aggressor_corporation_id int [ref: >? corporation.corporation_id]
  aggressor_alliance_id int [ref: >? alliance.alliance_id]
  defender_corporation_id int [ref: >? corporation.corporation_id]
  defender_alliance_id int [ref: >? alliance.alliance_id]
  declared timestamp
  started timestamp
  finished timestamp
  mutual boolean
  open_for_allies boolean
  aggressor_ships_killed int
  defender_ships_killed int
  Note: 'Latest daily snapshot of each war [16].'
}

Table sov_campaign {
  campaign_id int [pk]
  event_type varchar [not null, note: 'e.g. tcu_defense, ihub_defense']
  solar_system_id int [not null, ref: > solar_system.solar_system_id]
  defender_alliance_id int [ref: >? alliance.alliance_id]
  structure_id bigint
  start_time timestamp [not null]
  first_seen timestamp [note: '/derived: earliest hourly snapshot containing the campaign']
  last_seen timestamp [note: '/derived: latest hourly snapshot containing the campaign']
  final_attackers_score decimal [note: '/derived: attackers_score in the latest snapshot']
  final_defender_score decimal [note: '/derived: defender_score in the latest snapshot']
  Note: 'Territory fights. Hourly snapshots deduplicated on campaign_id [17].'
}

Table sovereignty_daily {
  date date [ref: > calendar_date.date]
  solar_system_id int [ref: > solar_system.solar_system_id]
  alliance_id int [not null, ref: > alliance.alliance_id]
  indexes {
    (date, solar_system_id) [pk]
  }
  Note: 'Who holds space: the player alliance holding each system, one ESI /sovereignty/map snapshot per day (first after downtime) via EVE Ref. Empire and unclaimed systems are left out.'
}

Table battle [headercolor: #9E9E9E] {
  battle_id int [pk]
  solar_system_id int [not null, ref: > solar_system.solar_system_id]
  start_time timestamp [not null, note: '/derived: first killmail in the cluster']
  end_time timestamp [not null, note: '/derived: last killmail in the cluster']
  battle_date date [not null, ref: > calendar_date.date, note: '/derived: date part of start_time']
  killmails int [note: '/derived: count of killmails in the cluster']
  pilots int [not null, note: '/derived: distinct character_id among the participants']
  battle_class varchar [not null, note: '/derived: skirmish if pilots 50-99, war if 100+. Size of a fight, not the official war declarations in the war table']
  Note: '/derived table. Killmails in the same system within an hour with 50+ distinct pilots [1].'
}

Table game_event {
  event_id int [pk, increment]
  event_date date [not null, ref: > calendar_date.date]
  date_precision varchar [not null, note: 'day / month / year']
  category varchar [not null, note: 'expansion / patch / deployment / sale / monetization / company / war / lore']
  title varchar [not null]
  source_id int [not null, ref: > source_document.source_id]
  source_ref varchar [note: 'article slug, SDE build number or video timestamp']
  Note: 'Timeline: patch notes and SDE builds [22], news [15], EVE University list [22], lore events [23].'
}

// ───────────────────────── Plan & Monetization (company level) ─────────────────────────

Table source_document {
  source_id int [pk]
  source_name varchar [not null]
  publisher varchar [not null]
  url varchar
  retrieved_at timestamp
  sha256 varchar
  data_nature varchar [note: 'real / anonymised / synthetic']
  Note: 'data/raw/sources.csv. Provenance for every figure.'
}

Table plan {
  plan_id int [pk]
  plan_name varchar [not null, note: 'e.g. Omega 1 month, Omega 12 months, PLEX 500']
  product_type varchar [not null, note: 'subscription / in-game currency']
  billing_cycle_months int [note: '1, 3, 6, 12, 24 (CCP accounting policy)']
  Note: 'Plan. Omega periods from CCP annual accounts [8]; packs from store pages [6] and news [7].'
}

Table plan_price {
  plan_id int [ref: > plan.plan_id]
  effective_date date [ref: > calendar_date.date]
  currency varchar
  list_price decimal
  sale_price decimal [note: 'when a sale was running']
  source_id int [not null, ref: > source_document.source_id]
  indexes {
    (plan_id, effective_date, currency) [pk]
  }
  Note: 'Price history [6][7].'
}

Table market_history_daily {
  date date [ref: > calendar_date.date]
  region_id int [ref: > region.region_id]
  type_id int [ref: > item_type.type_id]
  average_price decimal [note: 'ISK']
  highest_price decimal
  lowest_price decimal
  volume bigint
  order_count int
  indexes {
    (date, region_id, type_id) [pk]
  }
  Note: 'Market history [3], limited to the six real-money store items (PLEX etc.). PLEX (type_id 44992) is the monetization signal for 2026.'
}

Table financial_metric {
  metric_id int [pk, increment]
  period_start date [not null, ref: > calendar_date.date]
  period_end date [not null]
  granularity varchar [not null, note: 'quarter / year']
  entity varchar [not null, note: 'CCP ehf. / Pearl Abyss (EVE IP)']
  metric varchar [not null, note: 'total_revenue, subscription_and_ingame_revenue, marketing_expense, deferred_subscriptions, ...']
  geography varchar [note: 'North America / Europe / Asia / Other, when reported']
  amount decimal [not null]
  currency varchar [not null, note: 'USD (CCP) / KRW (Pearl Abyss)']
  source_id int [not null, ref: > source_document.source_id]
  Note: 'One reported figure per row. CCP annual accounts and Pearl Abyss reports [8].'
}

Table fx_rate {
  date date [ref: > calendar_date.date]
  currency_pair varchar [note: 'KRW/USD, USD/EUR']
  rate decimal [not null]
  indexes {
    (date, currency_pair) [pk]
  }
  Note: 'FRED daily exchange rates [13]. Converts Pearl Abyss KRW to USD.'
}

Table economy_daily {
  date date [ref: > calendar_date.date]
  metric varchar [note: 'total_isk, character_isk, isk_velocity, sink:<entry>, faucet:<entry>, mined_value, trade_value']
  value decimal [not null]
  indexes {
    (date, metric) [pk]
  }
  Note: 'MER [4] (latest MER only: each MER holds full history). Also the totals for miners and traders.'
}

// ───────────────────────── Acquisition & interest signals ─────────────────────────

Table interest_metric {
  period_start date [ref: > calendar_date.date]
  granularity varchar [note: 'week / month / year']
  source varchar [note: 'google_trends / steam / twitch']
  metric varchar [note: 'search_interest, avg_players, peak_players, hours_watched, avg_viewers, peak_viewers, streamers']
  geography varchar [note: 'Worldwide or country (Google Trends by country)']
  value decimal [not null]
  source_id int [not null, ref: > source_document.source_id]
  indexes {
    (period_start, granularity, source, metric, geography) [pk]
  }
  Note: 'External interest and channel signals, one figure per row: Google Trends [20], Steam players [14], Twitch [21].'
}

// ───────────────────────── Satisfaction ─────────────────────────

Table steam_review {
  recommendation_id bigint [pk]
  steam_author_id bigint [note: 'Steam account, NOT linkable to a character']
  created_date date [not null, ref: > calendar_date.date, note: '/derived: date of timestamp_created (unix)']
  language varchar
  voted_up boolean [note: 'recommend yes / no: the NPS proxy']
  playtime_at_review_hours decimal [note: '/derived: playtime_at_review (minutes) / 60']
  steam_purchase boolean
  received_for_free boolean
  votes_up int
  review_text text
  Note: 'SurveyResponse proxy. Steam appreviews API, app 8500 [5].'
}

Table forum_topic {
  topic_id int [pk]
  title varchar [not null]
  created_date date [not null, ref: > calendar_date.date, note: '/derived: date part of created_at']
  posts_count int
  matched_query varchar [note: 'search query that found it (title must also be on topic)']
  Note: 'Official forums [18].'
}

Table forum_post {
  post_id int [pk]
  topic_id int [not null, ref: > forum_topic.topic_id]
  created_date date [not null, ref: > calendar_date.date, note: '/derived: date part of created_at']
  author_hash varchar [note: '/derived: SHA-256 of the forum username. Counts distinct posters without storing names']
  post_text text [note: '/derived: post HTML (cooked) with tags stripped']
  Note: 'Official forums [18]. Feeds sentiment around price changes and the sale.'
}

// ───────────────────────── Benchmarks ─────────────────────────

Table benchmark_metric {
  benchmark_id int [pk, increment]
  game varchar [not null, note: 'World of Warcraft, EverQuest II, AION']
  metric varchar [not null, note: 'e.g. monthly_churn, retention_month_3']
  value decimal [not null]
  unit varchar
  period varchar [note: 'years the study covers']
  source_id int [not null, ref: > source_document.source_id]
  Note: 'Published MMO figures and figures computed from the WoWAH dataset [19]: the sanity check.'
}

// ───────────────────────── Groups (KPI areas) ─────────────────────────

TableGroup shared_dimensions {
  calendar_date
  region
  constellation
  solar_system
  item_category
  item_group
  item_type
}
TableGroup customer_acquisition {
  player_character
  corporation
  alliance
  character_signup_month
  interest_metric
}
TableGroup engagement_retention {
  killmail
  killmail_participant
  contract
  character_month_activity
  players_online_daily
}
TableGroup conflict_events {
  war
  sov_campaign
  battle
  game_event
}
TableGroup monetization {
  contract_item
  plan
  plan_price
  market_history_daily
  financial_metric
  fx_rate
  economy_daily
  source_document
}
TableGroup satisfaction {
  steam_review
  forum_topic
  forum_post
  benchmark_metric
}

Note erd_boundary {
'''
**Outside the ERD (no public data):** Subscription, Payment, Session, SupportTicket, AcquisitionChannel, Lead.
**Proxies inside it:** inferred_plan (Omega flag), players_online_daily (sessions, outages), interest_metric (channels), steam_review and forum_post (NPS/CSAT).
Monetization KPIs (MRR, ARPU, LTV, CAC) are estimates: company-level financial_metric ÷ per-player counts.
'''
}
