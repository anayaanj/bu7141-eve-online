      </column>
      <column caption='Selected net' datatype='integer' name='[Calculation_906000000000004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ABS([share_moved] - [Parameters].[Share moved]) &lt; 0.001 THEN [net_year_one] END' />
