      <aliases enabled='yes' />
      <column caption='Share of newcomers' datatype='real' default-format='p0.0%' name='[Calculation_900000000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([newcomers]) / MIN({ EXCLUDE [step] : SUM([newcomers]) })' />
      </column>
      <column caption='Still playing a year later' datatype='real' default-format='p0.0%' name='[Calculation_900010000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([still_playing]) / SUM([newcomers])' />
      </column>
      <column caption='Became paying' datatype='real' default-format='p0.0%' name='[Calculation_900020000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([omega_within_12_months]) / SUM([newcomers])' />
      </column>
      <column caption='Active 3+ months' datatype='real' default-format='p0.0%' name='[Calculation_900030000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_3_months_or_more]) / SUM([newcomers])' />
      </column>
      <column caption='Revenue per newcomer' datatype='real' name='[Calculation_900040000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue_first_year]) / SUM([newcomers])' />
      </column>
      <column caption='Share of those still playing' datatype='real' default-format='p0.0%' name='[Calculation_900050000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([still_playing]) / MIN({ EXCLUDE [step] : SUM([still_playing]) })' />
      </column>
      <column caption='Marketing 2025' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;-&quot;$&quot;#,##0,,.0M' name='[Calculation_900060000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_900000000000001] * MIN([engaged_2025]) * MIN([cac_per_engaged_newcomer])' />
      </column>
      <column caption='Revenue back 2025' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;-&quot;$&quot;#,##0,,.0M' name='[Calculation_900070000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_900000000000001] * MIN([engaged_2025]) * [Calculation_900040000000001]' />
      </column>
      <column caption='Gap 2025' datatype='real' name='[Calculation_906000000000003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_900070000000001] - [Calculation_900060000000001]' />
      </column>
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column aggregation='None' datatype='integer' name='[active_3_months_or_more]' role='measure' type='quantitative' />
      <column aggregation='None' datatype='integer' name='[active_months_first_year]' role='measure' type='quantitative' />
      <column aggregation='None' datatype='real' name='[arpu_month]' role='measure' type='quantitative' />
      <column aggregation='None' datatype='real' name='[cac_per_engaged_newcomer]' role='measure' type='quantitative' />
      <column aggregation='None' datatype='integer' name='[engaged_2025]' role='measure' type='quantitative' />
      <column aggregation='None' datatype='date' name='[first_month]' role='dimension' type='ordinal' />
