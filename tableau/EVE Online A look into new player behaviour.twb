            <column caption='Death Size' datatype='integer' name='[Calculation_4628107947003919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ZN(SUM([newcomers])) &gt;= 20 THEN SUM([newcomers]) ELSE 1 END' />
            </column>
            <column caption='Death Color' datatype='string' name='[Calculation_4628107947065360]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(SUM([newcomers])) &gt;= 20 THEN &apos;deaths&apos; ELSE &apos;none&apos; END' />
            </column>
            <column aggregation='Sum' caption='Link' datatype='integer' name='[Calculation_4628107947638802]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [layer] = &apos;link&apos; THEN INT(([link_id] + 1) / 2) END' />
