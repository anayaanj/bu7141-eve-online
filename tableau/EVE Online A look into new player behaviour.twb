      <column caption='Net Gain' datatype='integer' default-format='c&quot;$&quot;#,##0,,.0M;-&quot;$&quot;#,##0,,.0M' name='[Calculation_3524198752485376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_905010000000001] AND [net_year_one] &gt;= 0 THEN [net_year_one] END' />
      </column>
      <column caption='Net Loss' datatype='integer' default-format='c&quot;$&quot;#,##0,,.0M;-&quot;$&quot;#,##0,,.0M' name='[Calculation_3524198752538625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_905010000000001] AND [net_year_one] &lt; 0 THEN [net_year_one] END' />
      </column>
      <column caption='Net at slider' datatype='real' name='[Calculation_905000000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MIN(IIF([share_moved] = 0, [net_year_one], NULL)) } + [Parameters].[Share moved] * ({ FIXED : MIN(IIF([share_moved] = 1, [net_year_one], NULL)) } - { FIXED : MIN(IIF([share_moved] = 0, [net_year_one], NULL)) })' />
