    <worksheet name='A4 Worth'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>NET YEAR-ONE RESULT ON 2025 MARKETING, BY SHARE MOVED UP A STEP</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='A4Worth' path='/workbooks/EVEOnlineAlookintonewplayerbehaviour' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='step_up_projection' name='federated.step_up_projection' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Share moved' datatype='real' default-format='p0%' name='[Share moved]' param-domain-type='range' role='measure' type='quantitative' value='0.55000000000000004'>
              <calculation class='tableau' formula='0.55000000000000004' />
              <range granularity='0.05' max='1.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.step_up_projection'>
            <column caption='Selected share' datatype='boolean' name='[Calculation_905010000000001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ABS([share_moved] - [Parameters].[Share moved]) &lt; 0.001' />
            </column>
            <column caption='Selected net' datatype='integer' name='[Calculation_906000000000004]' role='measure' type='quantitative'>
