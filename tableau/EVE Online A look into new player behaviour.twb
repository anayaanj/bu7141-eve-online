      <column aggregation='Sum' caption='Link' datatype='integer' name='[Calculation_4628107793829891]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [layer] = &apos;link&apos; THEN INT(([link_id] + 1) / 2) END' />
      </column>
      <column caption='Link y' datatype='real' name='[Calculation_4628107793879044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [layer] = &apos;link&apos; THEN [map_y] END' />
      </column>
      <column caption='System y' datatype='real' name='[Calculation_4628107793915909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [layer] = &apos;system&apos; THEN [map_y] END' />
      </column>
      <column caption='Zone' datatype='string' name='[Calculation_4628107793960966]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [security_band]&#10;  WHEN &apos;High Sec&apos; THEN &apos;High-sec&apos;&#10;  WHEN &apos;Low Sec&apos; THEN &apos;Low-sec&apos;&#10;  WHEN &apos;Null Sec (NPC)&apos; THEN &apos;Null-sec&apos;&#10;  WHEN &apos;Null Sec (Sov)&apos; THEN &apos;Null-sec&apos;&#10;  ELSE &apos;Other&apos; END' />
      </column>
      <column caption='Battle usd (K)' datatype='integer' name='[Calculation_4628107861106697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [solar_system_name]&#10;  WHEN &apos;M2-XFE&apos; THEN 378&#10;  WHEN &apos;B-R5RB&apos; THEN 300&#10;  WHEN &apos;Atioth&apos; THEN 70&#10;  ELSE 1 END' />
      </column>
      <column caption='IsBattle' datatype='boolean' name='[Calculation_4628107861205002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_4628107861106697] &gt; 1' />
      </column>
      <column caption='MapColour' datatype='string' name='[Calculation_4628107861241867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4628107861205002] THEN &apos;Battle&apos; ELSE [Calculation_4628107793960966] END' />
      </column>
      <column caption='Battle Label' datatype='string' name='[Calculation_4628107862351884]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4628107861205002] THEN [solar_system_name] + &apos; · $&apos; + STR([Calculation_4628107861106697]) + &apos;K&apos; END' />
      </column>
