<?xml version='1.0'?>
<workbook>
  <preferences>
    <!-- EVE Online look for BU7141. Copy into "My Tableau Repository" (replace or merge with an existing Preferences.tps), then restart Tableau. -->
    <color-palette name="EVE story" type="regular">
      <color>#4fd1ff</color> <!-- group / win (accent) -->
      <color>#5b6b7a</color> <!-- alone / starter corporation -->
      <color>#f2c45a</color> <!-- money -->
      <color>#ff6b4a</color> <!-- death / loss -->
      <color>#5fe0a1</color> <!-- positive change -->
      <color>#b48cff</color>
      <color>#2e8fb8</color>
      <color>#c7d3de</color>
    </color-palette>
    <color-palette name="EVE alliances" type="regular">
      <color>#4fd1ff</color>
      <color>#f2c45a</color>
      <color>#ff6b4a</color>
      <color>#5fe0a1</color>
      <color>#b48cff</color>
      <color>#ff9ed2</color>
      <color>#2e8fb8</color>
      <color>#d4a017</color>
      <color>#e04848</color>
      <color>#3fb57a</color>
      <color>#7e63d6</color>
      <color>#9bb7c9</color>
      <color>#3a4652</color>
    </color-palette>
    <color-palette name="EVE heat" type="ordered-sequential">
      <color>#0d141c</color>
      <color>#1a5a73</color>
      <color>#4fd1ff</color>
      <color>#f2c45a</color>
      <color>#ff6b4a</color>
    </color-palette>
    <color-palette name="EVE security" type="regular">
      <color>#2f8cff</color> <!-- High Sec -->
      <color>#f2c45a</color> <!-- Low Sec -->
      <color>#ff4f4f</color> <!-- Null Sec -->
      <color>#b48cff</color> <!-- Wormhole -->
    </color-palette>
  </preferences>
</workbook>
