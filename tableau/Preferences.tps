<?xml version='1.0'?>
<workbook>
  <preferences>
    <!-- EVE Online look for BU7141, validated for the dark background (#0d141c). Copy into "My Tableau Repository", restart Tableau. -->
    <color-palette name="EVE story" type="regular">
      <color>#00a3c9</color> <!-- group / win; Goonswarm -->
      <color>#5b6b7a</color> <!-- alone / starter corporation; other alliances -->
      <color>#d25030</color> <!-- death by a player; Pandemic Horde -->
      <color>#8b5dce</color> <!-- death by the computer; Fraternity -->
      <color>#b08505</color> <!-- money (single-series charts only) -->
    </color-palette>
    <color-palette name="EVE heat" type="ordered-sequential">
      <color>#0f2a36</color>
      <color>#0a4d63</color>
      <color>#007394</color>
      <color>#00a3c9</color>
      <color>#7fd6f0</color>
    </color-palette>
  </preferences>
</workbook>
