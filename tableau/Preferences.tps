<?xml version='1.0'?>
<workbook>
  <preferences>
    <!-- EVE Online look for BU7141, validated for the dark background (#0d141c). Copy into "My Tableau Repository", restart Tableau. -->
    <color-palette name="EVE story" type="regular">
      <color>#00a3c9</color> <!-- group / win; Goonswarm -->
      <color>#5b6b7a</color> <!-- alone / starter corporation; other alliances -->
      <color>#d25030</color> <!-- death by a player; Pandemic Horde -->
      <color>#8b5dce</color> <!-- death by the computer; Fraternity -->
      <color>#b08505</color> <!-- money (single-series charts only) -->
    </color-palette>
    <color-palette name="EVE alliances" type="regular">
      <!-- The ten alliances that held the most space, Jan 2024 - Aug 2026, in rank order (sovereignty_monthly.rank); smaller alliances cycle through automatic colours -->
      <color>#00a3c9</color> <!-- 1 Goonswarm Federation -->
      <color>#8b5dce</color> <!-- 2 Fraternity -->
      <color>#d25030</color> <!-- 3 Pandemic Horde -->
      <color>#e3b53b</color> <!-- 4 Northern Coalition -->
      <color>#4cc47a</color> <!-- 5 The Initiative -->
      <color>#e879b6</color> <!-- 6 Dracarys -->
      <color>#b8d94a</color> <!-- 7 Sigma Grindset -->
      <color>#7c9cff</color> <!-- 8 Pan-Intergalatic Business Community -->
      <color>#2fc4b2</color> <!-- 9 Fanatic Legion -->
      <color>#a8b4c0</color> <!-- 10 Solyaris Chtonium -->
    </color-palette>
    <color-palette name="EVE heat" type="ordered-sequential">
      <color>#0f2a36</color>
      <color>#0a4d63</color>
      <color>#007394</color>
      <color>#00a3c9</color>
      <color>#7fd6f0</color>
    </color-palette>
  </preferences>
</workbook>
